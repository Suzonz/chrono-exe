{
  "name": "chrono-exe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension/tsconfig.json",
    "test": "jest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:demo": "ts-node prisma/demo.ts",
    "setup": "prisma migrate deploy && npm run db:seed",
    "build:extension": "tsc -p extension/tsconfig.json",
    "icons": "node scripts/generate-icons.mjs",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "test:coverage": "jest --coverage",
    "launcher:install": "node scripts/launcher.mjs install",
    "launcher:uninstall": "node scripts/launcher.mjs uninstall"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.14.0",
    "clsx": "2.1.1",
    "material-symbols": "^0.44.5",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.5.2",
    "@types/chrome": "^0.0.268",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.38",
    "prisma": "5.14.0",
    "puppeteer-core": "^22.15.0",
    "tailwindcss": "3.4.4",
    "ts-jest": "29.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  },
  "description": "Passive, real-time time tracking with a Chrome extension and a retro terminal dashboard.",
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT"
}
